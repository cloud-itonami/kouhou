{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM).
 :deps {
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.json"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"} ; aozora publish + LLM json
        io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `kbb -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; kbb -M:dev:run → drive one source digest through the actor
  :run {:main-opts ["-m" "kouhou.sim"]}
  ;; KOUHOU_ALLOW_LIVE_INGEST=1 kbb -M:live-ingest → real fetch + real publish
  ;; over every :verified registry/sources.seed.json source (kouhou.run-live-ingest).
  :live-ingest {:main-opts ["-m" "kouhou.run-live-ingest"]}
  ;; kbb -M:verify-corpus →各 corpus receipt を実ファイルと突き合わせる
  ;; （identity の検査。custody は git annex fsck --from kotobase が別に答える）
  :verify-corpus {:main-opts ["-m" "kouhou.verify-corpus"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
