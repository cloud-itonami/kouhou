{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM).
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"} ; aozora publish + LLM json
        io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `clojure -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; clojure -M:dev:run → drive one source digest through the actor
  :run {:main-opts ["-m" "kouhou.sim"]}
  ;; KOUHOU_ALLOW_LIVE_INGEST=1 clojure -M:live-ingest → real fetch + real publish
  ;; over every :verified registry/sources.seed.json source (kouhou.run-live-ingest).
  :live-ingest {:main-opts ["-m" "kouhou.run-live-ingest"]}
  ;; clojure -M:verify-corpus →各 corpus receipt を実ファイルと突き合わせる
  ;; （identity の検査。custody は git annex fsck --from kotobase が別に答える）
  :verify-corpus {:main-opts ["-m" "kouhou.verify-corpus"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
